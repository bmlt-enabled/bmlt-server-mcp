APP_NAME="BMLT MCP Server"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

#-------------------------------------------------------------------------
# BMLT
#-------------------------------------------------------------------------

# Default BMLT root server. Must include /main_server.
# The aggregator is a meta-root that federates every public root server, so
# searches return meetings worldwide. Override with a specific root if you
# only want to serve one region.
BMLT_ROOT_SERVER_URL=https://aggregator.bmltenabled.org/main_server

# Comma-separated allowlist for the optional `root_server_url` tool argument.
# The default BMLT_ROOT_SERVER_URL is always implicitly allowed.
BMLT_ALLOWED_ROOTS=

# Set to true to allow any URL via `root_server_url` (NOT recommended in production —
# enables SSRF-style queries to arbitrary hosts).
BMLT_ALLOW_ANY_ROOT=false

# BMLT aggregator used by the list_root_servers tool.
BMLT_AGGREGATOR_URL=https://aggregator.bmltenabled.org/main_server

BMLT_HTTP_TIMEOUT=15
BMLT_HTTP_USER_AGENT="bmlt-server-mcp/0.1 (+https://github.com/bmlt-enabled/bmlt-server-mcp)"

#-------------------------------------------------------------------------
# Geocoding
#-------------------------------------------------------------------------
# Driver: nominatim | google | null
GEOCODER=nominatim
GEOCODER_CACHE_TTL=86400

# Nominatim (OSM) — free, but ToS requires a meaningful User-Agent.
NOMINATIM_USER_AGENT="bmlt-server-mcp/0.1 (you@example.com)"
NOMINATIM_RATE_LIMIT_MS=1100

# Google Geocoding API (used when GEOCODER=google)
GOOGLE_GEOCODER_API_KEY=
# GOOGLE_GEOCODER_REGION=us
# GOOGLE_GEOCODER_LANGUAGE=en
